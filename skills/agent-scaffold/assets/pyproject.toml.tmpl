[project]
name = "${agent_name}"
version = "0.1.0"
description = "${description}"
requires-python = ">=3.12"
dependencies = [
    "anthropic>=0.70",
    "pydantic>=2.9",
    "httpx>=0.27",
]

[project.optional-dependencies]
dev = [
    "pytest>=8.0",
    "pytest-asyncio>=0.24",
]

[tool.pytest.ini_options]
# Async tests need no decorator, and the project root is importable from tests.
asyncio_mode = "auto"
pythonpath = ["."]
testpaths = ["tests"]
addopts = "-q"

[tool.ruff]
target-version = "py312"
line-length = 100
