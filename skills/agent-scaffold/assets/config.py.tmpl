"""Budget and model configuration for the ${agent_name} agent.

Every limit here is checked *before* an LLM call is issued, not after. A budget
you only discover you exceeded is a bill, not a limit.
"""

from __future__ import annotations

from typing import Literal

from pydantic import BaseModel, ConfigDict, Field

Effort = Literal["low", "medium", "high", "xhigh", "max"]


class AgentConfig(BaseModel):
    """Immutable run configuration."""

    model_config = ConfigDict(frozen=True)

    # --- Model selection -------------------------------------------------
    model: str = "${model}"
    fallback_models: tuple[str, ...] = ("${fallback_model}",)

    # Reasoning depth. Adaptive thinking plus `effort` replaces the fixed
    # thinking-token budget, which current models reject with a 400.
    effort: Effort = "high"

    # --- Hard budgets ----------------------------------------------------
    max_iterations: int = Field(default=10, ge=1, le=50)
    max_tool_calls: int = Field(default=25, ge=1, le=100)
    max_tokens: int = Field(default=100_000, ge=1)
    max_cost_usd: float = Field(default=0.50, gt=0)
    timeout_seconds: int = Field(default=120, ge=1, le=600)

    # Tool output above this size is truncated before it reaches the context.
    max_tool_output_chars: int = Field(default=10_000, ge=500)

    # Optional server-side pacing for the whole loop. Unlike max_tokens, the
    # model can see this countdown and wind down instead of being cut off.
    # The API requires at least 20,000 when set.
    task_budget_tokens: int | None = Field(default=None, ge=20_000)

    # --- Reliability -----------------------------------------------------
    max_retries: int = Field(default=3, ge=1, le=6)
    retry_base_delay: float = Field(default=0.5, gt=0)
    retry_max_delay: float = Field(default=8.0, gt=0)
    circuit_failure_threshold: int = Field(default=3, ge=1)
    circuit_cooldown_seconds: float = Field(default=30.0, gt=0)


class BudgetExceeded(RuntimeError):
    """Raised when a run would cross one of its configured limits."""

    def __init__(self, limit: str, used: float, allowed: float) -> None:
        super().__init__(f"{limit} exceeded: used {used}, allowed {allowed}")
        self.limit = limit
        self.used = used
        self.allowed = allowed
