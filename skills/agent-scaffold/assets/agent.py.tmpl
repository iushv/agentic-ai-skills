"""The ${agent_name} agent loop.

A level-${level} agent. The loop is deliberately explicit rather than delegated
to a framework, because the interesting parts are the checks *between* steps:
budgets before every model call, guardrails around every tool call, and a
degradation path when things go wrong.

The Anthropic client is injected so tests can drive the loop with a fake and
never touch the network.
"""

from __future__ import annotations

import asyncio
import time
from typing import Any, Protocol

from config import AgentConfig, BudgetExceeded
from guardrails.input import GuardrailBlocked, validate_input
from guardrails.output import validate_output
from models import AgentRun, StepKind, Usage
from reliability import CircuitOpen, FallbackChain
from tools import ToolRegistry
from tracing import Tracer, usage_from_response

# Cost per million tokens (input, output), in USD. Update when prices change;
# a stale table silently under-reports spend, which defeats the budget.
PRICE_PER_MTOK: dict[str, tuple[float, float]] = {
    "claude-fable-5": (10.0, 50.0),
    "claude-opus-5": (5.0, 25.0),
    "claude-sonnet-5": (3.0, 15.0),
    "claude-haiku-4-5": (1.0, 5.0),
}
DEFAULT_PRICE = (5.0, 25.0)


def estimate_cost(model: str, usage: Any) -> float:
    """Cost in USD for one response's usage block."""
    inp_rate, out_rate = PRICE_PER_MTOK.get(model, DEFAULT_PRICE)
    inp = getattr(usage, "input_tokens", 0) or 0
    out = getattr(usage, "output_tokens", 0) or 0
    return (inp * inp_rate + out * out_rate) / 1_000_000


class MessagesClient(Protocol):
    """The slice of the Anthropic client this agent actually uses."""

    messages: Any


class Agent:
    """Runs one query to completion, or fails in a defined way."""

    def __init__(
        self,
        *,
        tools: ToolRegistry,
        system_prompt: str,
        config: AgentConfig | None = None,
        client: MessagesClient | None = None,
    ) -> None:
        self.config = config or AgentConfig()
        self.tools = tools
        self.system_prompt = system_prompt
        self._client = client
        self._chain = FallbackChain(
            [self.config.model, *self.config.fallback_models],
            failure_threshold=self.config.circuit_failure_threshold,
            cooldown=self.config.circuit_cooldown_seconds,
        )

    # --- client ----------------------------------------------------------

    @property
    def client(self) -> MessagesClient:
        if self._client is None:
            from anthropic import AsyncAnthropic  # imported lazily

            self._client = AsyncAnthropic()
        return self._client

    # --- budget ----------------------------------------------------------

    def _check_budget(self, run: AgentRun, deadline: float) -> None:
        cfg = self.config
        if run.iterations >= cfg.max_iterations:
            raise BudgetExceeded("max_iterations", run.iterations, cfg.max_iterations)
        if run.tool_calls >= cfg.max_tool_calls:
            raise BudgetExceeded("max_tool_calls", run.tool_calls, cfg.max_tool_calls)
        if run.usage.cost_usd >= cfg.max_cost_usd:
            raise BudgetExceeded("max_cost_usd", run.usage.cost_usd, cfg.max_cost_usd)
        total_tokens = run.usage.input_tokens + run.usage.output_tokens
        if total_tokens >= cfg.max_tokens:
            raise BudgetExceeded("max_tokens", total_tokens, cfg.max_tokens)
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise BudgetExceeded("timeout_seconds", cfg.timeout_seconds, cfg.timeout_seconds)

    # --- model call ------------------------------------------------------

    def _request_kwargs(self, model: str, messages: list[dict[str, Any]], *, with_tools: bool) -> dict[str, Any]:
        cfg = self.config
        kwargs: dict[str, Any] = {
            "model": model,
            "max_tokens": 8192,
            "system": self.system_prompt,
            "messages": messages,
            # Adaptive thinking replaces fixed thinking-token budgets, which
            # current models reject outright.
            "thinking": {"type": "adaptive"},
            "output_config": {"effort": cfg.effort},
        }
        if with_tools:
            kwargs["tools"] = self.tools.schemas()
        if cfg.task_budget_tokens:
            kwargs["output_config"]["task_budget"] = {
                "type": "tokens",
                "total": cfg.task_budget_tokens,
            }
        return kwargs

    async def _call_model(
        self, run: AgentRun, tracer: Tracer, messages: list[dict[str, Any]], *, with_tools: bool = True
    ) -> Any:
        with tracer.step(StepKind.LLM_CALL, "messages.create") as step:
            model, response = await self._chain.run(
                lambda m: self.client.messages.create(
                    **self._request_kwargs(m, messages, with_tools=with_tools)
                ),
                max_attempts=self.config.max_retries,
                base_delay=self.config.retry_base_delay,
                max_delay=self.config.retry_max_delay,
            )
            cost = estimate_cost(model, getattr(response, "usage", None))
            step.usage = usage_from_response(response, cost)
            step.detail["model"] = model
            step.detail["stop_reason"] = getattr(response, "stop_reason", None)
        return response

    # --- tools -----------------------------------------------------------

    async def _run_tool(self, run: AgentRun, tracer: Tracer, block: Any) -> dict[str, Any]:
        """Execute one tool_use block through the guardrails and return its result."""
        with tracer.step(StepKind.TOOL_CALL, block.name, tool_use_id=block.id) as step:
            result = await self.tools.invoke(block.name, dict(block.input))
            result = result.truncated(self.config.max_tool_output_chars)
            step.detail["success"] = result.success
            if not result.success:
                step.error = result.error
        return {
            "type": "tool_result",
            "tool_use_id": block.id,
            "content": str(result.data if result.success else result.error),
            "is_error": not result.success,
        }

    # --- degradation -----------------------------------------------------

    async def _degrade(self, run: AgentRun, tracer: Tracer, messages: list[dict[str, Any]], reason: str) -> str:
        """Level 3: answer directly, no tools. Level 5: apologise honestly."""
        run.status = "degraded"
        run.degradation_level = 3
        tracer.event("degradation", level=3, reason=reason)
        try:
            response = await self._call_model(run, tracer, messages, with_tools=False)
            return _first_text(response) or _LEVEL_5
        except BaseException:  # noqa: BLE001 - degradation must not raise
            run.degradation_level = 5
            tracer.event("degradation", level=5, reason=reason)
            return _LEVEL_5

    # --- entrypoint ------------------------------------------------------

    async def run(self, query: str, conversation_id: str = "default") -> AgentRun:
        run = AgentRun(query=query)
        tracer = Tracer(run)
        tracer.run_started()
        deadline = time.monotonic() + self.config.timeout_seconds

        try:
            with tracer.step(StepKind.GUARDRAIL, "input"):
                validated = validate_input(query, conversation_id)
        except GuardrailBlocked as exc:
            run.status = "failed"
            run.answer = "I can't process that request."
            tracer.event("blocked", stage="input", reasons=exc.reasons)
            tracer.run_finished()
            return run

        messages: list[dict[str, Any]] = [
            {"role": "user", "content": validated.query}
        ]
        tool_outputs: list[str] = []
        answer: str | None = None

        try:
            while True:
                self._check_budget(run, deadline)
                response = await asyncio.wait_for(
                    self._call_model(run, tracer, messages),
                    timeout=max(deadline - time.monotonic(), 0.1),
                )

                if getattr(response, "stop_reason", None) != "tool_use":
                    answer = _first_text(response)
                    break

                messages.append({"role": "assistant", "content": response.content})
                blocks = [b for b in response.content if getattr(b, "type", None) == "tool_use"]
                results = await asyncio.gather(
                    *(self._run_tool(run, tracer, b) for b in blocks)
                )
                tool_outputs.extend(str(r["content"]) for r in results)
                # All results go back in a single user turn. Splitting them
                # teaches the model to stop making parallel calls.
                messages.append({"role": "user", "content": list(results)})

        except BudgetExceeded as exc:
            tracer.event("budget_exceeded", limit=exc.limit, used=exc.used)
            answer = await self._degrade(run, tracer, messages, f"budget:{exc.limit}")
        except (CircuitOpen, asyncio.TimeoutError) as exc:
            tracer.event("provider_failure", error=str(exc))
            run.status = "degraded"
            run.degradation_level = 5
            answer = _LEVEL_5
        except BaseException as exc:  # noqa: BLE001 - never fail silently
            tracer.event("unhandled_error", error=f"{type(exc).__name__}: {exc}")
            answer = await self._degrade(run, tracer, messages, "unhandled_error")

        with tracer.step(StepKind.GUARDRAIL, "output"):
            report = validate_output(
                answer or _LEVEL_5,
                system_prompt=self.system_prompt,
                tool_outputs=tool_outputs,
            )
        if report.redactions or report.leaked_prompt or report.unsupported_claims:
            tracer.event(
                "output_findings",
                redactions=report.redactions,
                leaked_prompt=report.leaked_prompt,
                unsupported_claims=report.unsupported_claims,
            )

        run.answer = report.text
        if run.status == "running":
            run.status = "completed"
        run.usage = run.usage or Usage()
        tracer.run_finished()
        return run


_LEVEL_5 = (
    "I ran into a problem I couldn't recover from and don't want to guess at an "
    "answer. Please try again in a minute."
)


def _first_text(response: Any) -> str | None:
    """Pull the first text block out of a response, ignoring thinking blocks."""
    for block in getattr(response, "content", []) or []:
        if getattr(block, "type", None) == "text":
            return getattr(block, "text", None)
    return None
