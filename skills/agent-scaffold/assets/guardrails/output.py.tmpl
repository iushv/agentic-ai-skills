"""Output guardrails for ${agent_name} (defence layer 6).

Runs after the agent produces an answer and before the user sees it: scrub PII,
check nothing leaked from the system prompt, and verify the answer is actually
supported by what the tools returned.
"""

from __future__ import annotations

import re

from pydantic import BaseModel, Field

PII_PATTERNS: dict[str, re.Pattern[str]] = {
    "EMAIL": re.compile(r"\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}\b"),
    "PHONE": re.compile(r"\b(?:\+?\d{1,3}[ -]?)?\(?\d{3}\)?[ .-]?\d{3}[ .-]?\d{4}\b"),
    "SSN": re.compile(r"\b\d{3}-\d{2}-\d{4}\b"),
    "CREDIT_CARD": re.compile(r"\b(?:\d[ -]?){13,16}\b"),
    "IPV4": re.compile(r"\b(?:\d{1,3}\.){3}\d{1,3}\b"),
}


class OutputReport(BaseModel):
    """What the output pipeline did, so it can be logged and alerted on."""

    text: str
    redactions: dict[str, int] = Field(default_factory=dict)
    leaked_prompt: bool = False
    grounded: bool | None = None
    unsupported_claims: list[str] = Field(default_factory=list)


def scrub_pii(text: str) -> tuple[str, dict[str, int]]:
    """Mask PII and report how many of each kind were found."""
    counts: dict[str, int] = {}
    for label, pattern in PII_PATTERNS.items():
        text, n = pattern.subn(f"[{label}_REDACTED]", text)
        if n:
            counts[label] = n
    return text, counts


def leaked_system_prompt(text: str, system_prompt: str, *, shingle: int = 12) -> bool:
    """Detect verbatim system-prompt fragments echoed into the answer.

    Compares overlapping word windows rather than the whole string, because a
    leak is usually a fragment, not the entire prompt.
    """
    prompt_words = system_prompt.split()
    if len(prompt_words) < shingle:
        return system_prompt.strip() != "" and system_prompt.strip() in text
    haystack = " ".join(text.split()).lower()
    for i in range(len(prompt_words) - shingle + 1):
        window = " ".join(prompt_words[i : i + shingle]).lower()
        if window in haystack:
            return True
    return False


def check_grounding(answer: str, tool_outputs: list[str]) -> tuple[bool, list[str]]:
    """Cheap grounding heuristic: every number in the answer should appear in a
    tool result.

    This does not prove the answer is correct. It catches the common failure
    where the model invents a figure the tools never produced. Replace it with a
    model-graded check when the stakes justify the cost.
    """
    if not tool_outputs:
        return True, []
    haystack = " ".join(tool_outputs)
    numbers = set(re.findall(r"\b\d[\d,]*\.?\d*\b", answer))
    unsupported = [
        n for n in numbers if n.replace(",", "") not in haystack.replace(",", "")
    ]
    return not unsupported, sorted(unsupported)


def validate_output(
    answer: str,
    *,
    system_prompt: str = "",
    tool_outputs: list[str] | None = None,
) -> OutputReport:
    """Run the full output pipeline and return the cleaned text plus findings."""
    text, redactions = scrub_pii(answer)
    leaked = leaked_system_prompt(text, system_prompt) if system_prompt else False
    if leaked:
        text = (
            "I can't share my configuration. Here is the answer without it:\n\n"
            + text
        )
    grounded, unsupported = (
        check_grounding(text, tool_outputs) if tool_outputs is not None else (None, [])
    )
    return OutputReport(
        text=text,
        redactions=redactions,
        leaked_prompt=leaked,
        grounded=grounded,
        unsupported_claims=unsupported,
    )
