"""The ${agent_name} agent (level 2, router).

A router is not a loop. It classifies the request into exactly one handler,
runs it, and phrases the result. Two model calls, one tool call, always — so it
cannot run away, and its cost is predictable before you send it.

Use this when the set of task types is known in advance. The moment the agent
needs to *chain* tools or decide what to do next based on a tool result, it has
outgrown a router: regenerate at level 3.

The public API matches the level-3 agent, so swapping between them is a
one-line change at the call site.
"""

from __future__ import annotations

import asyncio
import time
from typing import Any

from config import AgentConfig, BudgetExceeded
from guardrails.input import GuardrailBlocked, validate_input
from guardrails.output import validate_output
from llm import MessagesClient, ModelCaller, first_text, tool_use_blocks
from models import AgentRun, StepKind
from reliability import CircuitOpen
from tools import ToolRegistry
from tracing import Tracer

DEGRADED_MESSAGE = (
    "I ran into a problem I couldn't recover from and don't want to guess at an "
    "answer. Please try again in a minute."
)

ROUTING_SUFFIX = """

Select exactly one tool for this request. Do not explain your choice; the tool
call is the answer. If no tool fits, choose the closest one and say so in its
arguments."""


class Agent:
    """Classify, dispatch once, answer. No iteration."""

    def __init__(
        self,
        *,
        tools: ToolRegistry,
        system_prompt: str,
        config: AgentConfig | None = None,
        client: MessagesClient | None = None,
    ) -> None:
        self.config = config or AgentConfig()
        self.tools = tools
        self.system_prompt = system_prompt
        self.llm = ModelCaller(self.config, client)

    def _check_budget(self, run: AgentRun, deadline: float) -> None:
        cfg = self.config
        if run.usage.cost_usd >= cfg.max_cost_usd:
            raise BudgetExceeded("max_cost_usd", run.usage.cost_usd, cfg.max_cost_usd)
        total_tokens = run.usage.input_tokens + run.usage.output_tokens
        if total_tokens >= cfg.max_tokens:
            raise BudgetExceeded("max_tokens", total_tokens, cfg.max_tokens)
        if deadline - time.monotonic() <= 0:
            raise BudgetExceeded(
                "timeout_seconds", cfg.timeout_seconds, cfg.timeout_seconds
            )

    async def run(self, query: str, conversation_id: str = "default") -> AgentRun:
        run = AgentRun(query=query)
        tracer = Tracer(run)
        tracer.run_started()
        deadline = time.monotonic() + self.config.timeout_seconds

        try:
            with tracer.step(StepKind.GUARDRAIL, "input"):
                validated = validate_input(query, conversation_id)
        except GuardrailBlocked as exc:
            run.status = "failed"
            run.answer = "I can't process that request."
            tracer.event("blocked", stage="input", reasons=exc.reasons)
            tracer.run_finished()
            return run

        messages: list[dict[str, Any]] = [{"role": "user", "content": validated.query}]
        tool_outputs: list[str] = []
        answer: str | None = None

        try:
            # Step 1 - route. `tool_choice: any` forces exactly one tool call,
            # which is what makes this a router rather than a one-shot agent.
            self._check_budget(run, deadline)
            routed = await asyncio.wait_for(
                self.llm.call(
                    tracer,
                    messages,
                    self.system_prompt + ROUTING_SUFFIX,
                    tools=self.tools.schemas(),
                    tool_choice={"type": "any"},
                    label="route",
                ),
                timeout=max(deadline - time.monotonic(), 0.1),
            )

            blocks = tool_use_blocks(routed)
            if not blocks:
                # The model answered instead of routing. Take the answer rather
                # than forcing a retry that would cost another call.
                answer = first_text(routed)
                tracer.event("no_route", reason="model returned text, not a tool call")
            else:
                block = blocks[0]
                with tracer.step(
                    StepKind.TOOL_CALL, block.name, tool_use_id=block.id
                ) as step:
                    result = await self.tools.invoke(block.name, dict(block.input))
                    result = result.truncated(self.config.max_tool_output_chars)
                    step.detail["success"] = result.success
                    if not result.success:
                        step.error = result.error

                payload = str(result.data if result.success else result.error)
                tool_outputs.append(payload)
                messages.append({"role": "assistant", "content": routed.content})
                messages.append(
                    {
                        "role": "user",
                        "content": [
                            {
                                "type": "tool_result",
                                "tool_use_id": block.id,
                                "content": payload,
                                "is_error": not result.success,
                            }
                        ],
                    }
                )

                # Step 2 - phrase the result. No tools, so this cannot start a
                # second round of tool use.
                self._check_budget(run, deadline)
                final = await asyncio.wait_for(
                    self.llm.call(
                        tracer, messages, self.system_prompt, label="answer"
                    ),
                    timeout=max(deadline - time.monotonic(), 0.1),
                )
                answer = first_text(final)

        except BudgetExceeded as exc:
            tracer.event("budget_exceeded", limit=exc.limit, used=exc.used)
            run.status = "degraded"
            run.degradation_level = 5
            answer = DEGRADED_MESSAGE
        except (CircuitOpen, asyncio.TimeoutError) as exc:
            tracer.event("provider_failure", error=str(exc))
            run.status = "degraded"
            run.degradation_level = 5
            answer = DEGRADED_MESSAGE
        except BaseException as exc:  # noqa: BLE001 - never fail silently
            tracer.event("unhandled_error", error=f"{type(exc).__name__}: {exc}")
            run.status = "degraded"
            run.degradation_level = 5
            answer = DEGRADED_MESSAGE

        with tracer.step(StepKind.GUARDRAIL, "output"):
            report = validate_output(
                answer or DEGRADED_MESSAGE,
                system_prompt=self.system_prompt,
                tool_outputs=tool_outputs,
            )
        if report.redactions or report.leaked_prompt or report.unsupported_claims:
            tracer.event(
                "output_findings",
                redactions=report.redactions,
                leaked_prompt=report.leaked_prompt,
                unsupported_claims=report.unsupported_claims,
            )

        run.answer = report.text
        if run.status == "running":
            run.status = "completed"
        tracer.run_finished()
        return run
