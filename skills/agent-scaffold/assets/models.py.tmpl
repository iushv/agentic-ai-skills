"""Shared data models for the ${agent_name} agent.

These are the structures every layer agrees on: what a step looks like, what a
tool returns, and what a completed run reports. Keep them boring and typed.
"""

from __future__ import annotations

from datetime import datetime, timezone
from enum import Enum
from typing import Any, Literal
from uuid import uuid4

from pydantic import BaseModel, Field


def _now() -> datetime:
    return datetime.now(timezone.utc)


def _run_id() -> str:
    return f"run_{uuid4().hex[:12]}"


class StepKind(str, Enum):
    LLM_CALL = "llm_call"
    TOOL_CALL = "tool_call"
    GUARDRAIL = "guardrail"
    ERROR = "error"


class Usage(BaseModel):
    """Token and cost accounting for a single LLM call."""

    input_tokens: int = 0
    output_tokens: int = 0
    cache_read_tokens: int = 0
    cost_usd: float = 0.0

    def __add__(self, other: "Usage") -> "Usage":
        return Usage(
            input_tokens=self.input_tokens + other.input_tokens,
            output_tokens=self.output_tokens + other.output_tokens,
            cache_read_tokens=self.cache_read_tokens + other.cache_read_tokens,
            cost_usd=self.cost_usd + other.cost_usd,
        )


class ToolResult(BaseModel):
    """Every tool returns this. Never a bare string, never a raw dict."""

    success: bool
    data: Any = None
    error: str | None = None
    metadata: dict[str, Any] = Field(default_factory=dict)

    def truncated(self, limit: int) -> "ToolResult":
        """Return a copy whose rendered data fits within `limit` characters."""
        rendered = str(self.data)
        if len(rendered) <= limit:
            return self
        keep = limit - 80
        note = f"\n\n[truncated {len(rendered) - keep} of {len(rendered)} chars]"
        return self.model_copy(
            update={
                "data": rendered[:keep] + note,
                "metadata": {**self.metadata, "truncated": True},
            }
        )


class AgentStep(BaseModel):
    """One observable action inside a run. This is what tracing emits."""

    index: int
    kind: StepKind
    name: str
    started_at: datetime = Field(default_factory=_now)
    duration_ms: float | None = None
    usage: Usage = Field(default_factory=Usage)
    error: str | None = None
    detail: dict[str, Any] = Field(default_factory=dict)


class AgentRun(BaseModel):
    """The full record of one request through the agent."""

    run_id: str = Field(default_factory=_run_id)
    query: str
    answer: str | None = None
    status: Literal["running", "completed", "failed", "degraded"] = "running"
    steps: list[AgentStep] = Field(default_factory=list)
    usage: Usage = Field(default_factory=Usage)
    started_at: datetime = Field(default_factory=_now)
    finished_at: datetime | None = None
    degradation_level: int = 1

    @property
    def tool_calls(self) -> int:
        return sum(1 for s in self.steps if s.kind is StepKind.TOOL_CALL)

    @property
    def iterations(self) -> int:
        return sum(1 for s in self.steps if s.kind is StepKind.LLM_CALL)

    def record(self, step: AgentStep) -> AgentStep:
        self.steps.append(step)
        self.usage = self.usage + step.usage
        return step
