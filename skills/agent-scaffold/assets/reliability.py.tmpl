"""Retry, circuit breaking, and model fallback for the ${agent_name} agent.

The Anthropic SDK already retries connection errors, 408, 409, 429 and 5xx with
backoff. This module covers what it does not: tracking failures *per provider*
so a wedged model is skipped entirely rather than retried on every request.
"""

from __future__ import annotations

import asyncio
import random
import time
from collections.abc import Awaitable, Callable
from typing import TypeVar

T = TypeVar("T")

# Errors worth retrying. Anything else is a bug in the request and retrying it
# just burns the budget.
TRANSIENT_STATUS = frozenset({408, 409, 429, 500, 502, 503, 504, 529})


def is_transient(exc: BaseException) -> bool:
    """True when retrying `exc` could plausibly succeed."""
    if isinstance(exc, (asyncio.TimeoutError, ConnectionError, TimeoutError)):
        return True
    status = getattr(exc, "status_code", None) or getattr(exc, "status", None)
    return isinstance(status, int) and status in TRANSIENT_STATUS


class CircuitOpen(RuntimeError):
    """Raised when a provider's circuit is open and the call was not attempted."""


class CircuitBreaker:
    """Per-provider failure tracker.

    Closed -> open after `failure_threshold` consecutive failures. After
    `cooldown` seconds it half-opens and allows a single probe; a success closes
    it, a failure re-opens it for another cooldown.
    """

    def __init__(self, failure_threshold: int = 3, cooldown: float = 30.0) -> None:
        self.failure_threshold = failure_threshold
        self.cooldown = cooldown
        self._failures = 0
        self._opened_at: float | None = None

    @property
    def is_open(self) -> bool:
        if self._opened_at is None:
            return False
        if time.monotonic() - self._opened_at >= self.cooldown:
            return False  # half-open: allow one probe through
        return True

    def record_success(self) -> None:
        self._failures = 0
        self._opened_at = None

    def record_failure(self) -> None:
        self._failures += 1
        if self._failures >= self.failure_threshold:
            self._opened_at = time.monotonic()


async def with_retry(
    fn: Callable[[], Awaitable[T]],
    *,
    max_attempts: int = 3,
    base_delay: float = 0.5,
    max_delay: float = 8.0,
) -> T:
    """Run `fn`, retrying transient failures with exponential backoff and jitter."""
    last: BaseException | None = None
    for attempt in range(max_attempts):
        try:
            return await fn()
        except BaseException as exc:  # noqa: BLE001 - re-raised below
            if not is_transient(exc) or attempt == max_attempts - 1:
                raise
            last = exc
            delay = min(base_delay * (2**attempt), max_delay)
            await asyncio.sleep(delay + random.uniform(0, delay * 0.25))
    raise last  # pragma: no cover - unreachable, loop either returns or raises


class FallbackChain:
    """Try each model in order, skipping any whose circuit is open."""

    def __init__(
        self,
        models: list[str],
        *,
        failure_threshold: int = 3,
        cooldown: float = 30.0,
    ) -> None:
        if not models:
            raise ValueError("FallbackChain needs at least one model")
        self.models = models
        self._breakers = {
            m: CircuitBreaker(failure_threshold, cooldown) for m in models
        }

    def breaker(self, model: str) -> CircuitBreaker:
        return self._breakers[model]

    @property
    def all_open(self) -> bool:
        return all(b.is_open for b in self._breakers.values())

    async def run(
        self,
        call: Callable[[str], Awaitable[T]],
        *,
        max_attempts: int = 3,
        base_delay: float = 0.5,
        max_delay: float = 8.0,
    ) -> tuple[str, T]:
        """Call `call(model)` down the chain. Returns the model that succeeded."""
        errors: list[str] = []
        for model in self.models:
            breaker = self._breakers[model]
            if breaker.is_open:
                errors.append(f"{model}: circuit open")
                continue
            try:
                result = await with_retry(
                    lambda m=model: call(m),
                    max_attempts=max_attempts,
                    base_delay=base_delay,
                    max_delay=max_delay,
                )
            except BaseException as exc:  # noqa: BLE001 - recorded and moved past
                breaker.record_failure()
                errors.append(f"{model}: {type(exc).__name__}: {exc}")
                continue
            breaker.record_success()
            return model, result
        raise CircuitOpen("every model in the chain failed: " + "; ".join(errors))
