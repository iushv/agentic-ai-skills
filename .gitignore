# Python build artefacts. These must never be committed: the skill mirrors are
# compared with `diff -r`, so a stray __pycache__ breaks sync parity.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# macOS
.DS_Store

# Generated by scripts/sync-rules.sh at the *parent* of this package, but keep
# these ignored in case anyone runs it from inside the repo.
/.cursor/
/.windsurf/
/.agents/
/.claude/skills/
